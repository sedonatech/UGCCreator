# ============================================================
# UGCCreator - Environment Variables
# ============================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to source control.
# ============================================================

# RevenueCat
REVENUECAT_ANDROID_KEY=
REVENUECAT_IOS_KEY=

# Firebase
FIREBASE_SERVER_KEY=

# Stream Chat
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_APP_ID=

# Facebook
FACEBOOK_APP_ID=

# App Store Connect API (for Fastlane)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT=

# Fastlane Match
MATCH_GIT_URL=
MATCH_PASSWORD=

# Apple
APPLE_ID=
APPLE_TEAM_ID=
ITC_TEAM_ID=

# Android Signing
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Google Play
GOOGLE_PLAY_JSON_KEY_FILE=
